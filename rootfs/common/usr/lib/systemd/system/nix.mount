[Unit]
Description=Bind mount /var/lib/nix onto /nix
Documentation=man:mount(8) https://nix.dev/manual/nix/stable/installation/nix-security.html
# /var/lib/nix is the persistent backing directory; /nix lives on the
# read-only composefs deployment root and would not survive updates.
# Seed /var/lib/nix from /nix at image build time, then bind it over /nix.
RequiresMountsFor=/var
# NOTE: do NOT add `After=local-fs.target` here. systemd already gives every
# local .mount unit an implicit `Before=local-fs.target`, so an explicit
# `After=local-fs.target` forms an ordering cycle. systemd then breaks the
# cycle by deleting the nix.mount job, silently leaving /nix on the read-only
# composefs root (the mount never happens and nix writes are lost on update).
Before=nix-daemon.service nix-daemon.socket
# Recreate the mount point if a previous deployment lacked it.
ConditionPathIsDirectory=/var/lib/nix

[Mount]
What=/var/lib/nix
Where=/nix
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
