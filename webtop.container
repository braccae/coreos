[Unit]
Description=Fedora KDE Webtop Container with Selkies (Pixelflux Wayland)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=webtop
Image=ghcr.io/braccae/webtop:latest
PublishPort=3000:3000
# GPU render node for hardware capture/encode. Remove for software rendering.
AddDevice=/dev/dri
# FUSE for AppImages (fusermount is setuid, the container's root needs SYS_ADMIN).
AddDevice=/dev/fuse
# TUN for WireGuard clients (Tailscale, Cloudflare WARP). Rootless pasta owns the
# container netns, so NET_ADMIN + /dev/net/tun is enough to create tun/wireguard
# interfaces and get the client's overlay IP; no host network access is needed.
AddDevice=/dev/net/tun
# CEF/Chromium (Steam, Discover, Bazaar) needs more than podman's 64 MB
# /dev/shm or steamwebhelper crash-loops. For a pod, pass
# --shm-size=1g to `podman pod create` instead.
ShmSize=1g
AddCapability=SYS_ADMIN
# NetworkManager needs NET_ADMIN to take ownership of the pasta tap instead of
# only assuming it; without it the desktop network indicator shows "unavailable".
AddCapability=NET_ADMIN
# Podman's default pids limit (2048) also caps the session through systemd's
# default TasksMax=15%, which a KDE session with a browser exhausts (thread
# creation fails, the panel freezes). TasksMax=infinity in webtop.service
# removes the service cap; this raises the container-wide ceiling.
PidsLimit=8192
# Flatpak needs to create namespaces; without these bwrap cannot mount /proc
# ("Can't mount proc on /proc: Operation not permitted").
SecurityLabelDisable=true
SeccompProfile=unconfined
PodmanArgs=--systemd=always --security-opt=unmask=all
# bootc layout: the image is read-only, /home is a symlink to /var/home, and
# only /var and /etc are writable. Persist exactly those two; /home, Flatpaks,
# WARP state and the AppStream cache live under /var, and /etc is merged from
# the image's factory snapshot by etc-overlay-sync.service.
Volume=webtop-var:/var
Volume=webtop-etc:/etc
# Optional: ROCm/OpenCL on AMD GPUs.
#AddDevice=/dev/kfd

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
