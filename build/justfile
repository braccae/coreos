# Configure package repositories for a given target (alma | ublue | docker | elrepo)
[group('repos')]
setup-repos target repos_dir="/tmp/repos":
    #!/usr/bin/env bash
    set -euo pipefail

    TARGET="{{target}}"
    REPOS_DIR="{{repos_dir}}"

    case "$TARGET" in
        alma)
            RHEL_VER="$(rpm -E %rhel)"
            EPEL_URL="https://dl.fedoraproject.org/pub/epel/epel-release-latest-${RHEL_VER}.noarch.rpm"
            RPMFUSION_FREE_URL="https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-${RHEL_VER}.noarch.rpm"
            RPMFUSION_NONFREE_URL="https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-${RHEL_VER}.noarch.rpm"
            dnf install -y --nogpgcheck \
                "$EPEL_URL" \
                "$RPMFUSION_FREE_URL" \
                "$RPMFUSION_NONFREE_URL"
            curl -fsSL https://pkgs.tailscale.com/stable/rhel/10/tailscale.repo \
                -o /etc/yum.repos.d/tailscale.repo
            for repo_file in cloudflare-warp.repo crowdsec.repo wazuh.repo; do
                if [ -f "${REPOS_DIR}/${repo_file}" ]; then
                    cp "${REPOS_DIR}/${repo_file}" "/etc/yum.repos.d/${repo_file}"
                fi
            done
            rpm --import https://packages.wazuh.com/key/GPG-KEY-WAZUH
            ;;
        ublue)
            for repo_file in cloudflare-warp.repo code.repo; do
                if [ -f "${REPOS_DIR}/${repo_file}" ]; then
                    cp "${REPOS_DIR}/${repo_file}" "/etc/yum.repos.d/${repo_file}"
                fi
            done
            mkdir -p /var/lib/alternatives
            dnf5 install -y dnf-plugins-core
            # Terra
            dnf5 config-manager addrepo --from-repofile=https://github.com/terrapkg/subatomic-repos/raw/main/terra.repo
            dnf5 install -y terra-release
            # GitHub CLI
            dnf5 config-manager addrepo --from-repofile=https://cli.github.com/packages/rpm/gh-cli.repo
            # ACT local GitHub Actions + Ghostty terminal
            dnf5 -y copr enable goncalossilva/act
            dnf5 -y copr enable scottames/ghostty
            # VSCode
            rpm --import https://packages.microsoft.com/keys/microsoft.asc
            ;;
        docker)
            dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
            ;;
        elrepo)
            # ELRepo is used for prebuilt weak-modules only; kernel-ml is never installed.
            dnf install -y --nogpgcheck https://www.elrepo.org/elrepo-release-10.el10.elrepo.noarch.rpm
            ;;
        *)
            echo "ERROR: Unknown repo target '${TARGET}'. Expected one of: alma, ublue, docker, elrepo" >&2
            exit 1
            ;;
    esac

