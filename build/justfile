# ==============================================================================
# Container Build Justfile — central build tasks for all Containerfiles
# ==============================================================================
#
# Invoked during container builds via:
#   just -f /tmp/build.justfile <recipe> [args...]
#
# All internal self-calls MUST use `just -f "{{justfile()}}"` so recipes work
# safely from any working directory (Alma images ship a system-wide `/justfile`
# that bare `just` would otherwise pick up).
#
# Package-installing sub-recipes intentionally do NOT clean DNF caches so
# callers can chain multiple `install-*` recipes in a single `RUN` layer
# sharing downloaded metadata, then call `cleanup-dnf` once at the end.
# ==============================================================================

set shell := ["bash", "-euo", "pipefail", "-c"]

# List all available build recipes
default:
    @just -f "{{justfile()}}" --list

# ==============================================================================
# 1. Core Helpers & Utilities
# ==============================================================================

# Print the active kernel version (directory under /usr/lib/modules containing vmlinuz)
[group('helpers')]
get-active-kernel:
    @for d in /usr/lib/modules/*/; do v=$(basename "$d"); if [ -f "${d}vmlinuz" ]; then printf "%s\n" "$v"; exit 0; fi; done; echo "ERROR: no active kernel found" >&2; exit 1

# Print the active kernel base version (everything before the first '-')
[group('helpers')]
get-active-kernel-base:
    @FULL_VER=$(just -f "{{justfile()}}" get-active-kernel); printf "%s\n" "$FULL_VER" | cut -d- -f1

# Download assets from the latest GitHub release matching all comma-separated substrings (case-insensitive)
[group('helpers')]
get-gh-release url tags="" out_dir=".":
    #!/usr/bin/env bash
    set -euo pipefail

    REPO_URL="{{url}}"
    TAGS="{{tags}}"
    OUT_DIR="{{out_dir}}"

    if ! command -v jq >/dev/null 2>&1; then
        echo "ERROR: jq is required by get-gh-release" >&2
        exit 1
    fi

    # Extract owner/repo from a GitHub URL (handling trailing slash and .git suffix)
    if [[ "$REPO_URL" == *github.com/* ]]; then
        OWNER_REPO="${REPO_URL#*github.com/}"
    else
        OWNER_REPO="$REPO_URL"
    fi
    OWNER_REPO="${OWNER_REPO%/}"
    OWNER_REPO="${OWNER_REPO%.git}"
    OWNER_REPO="${OWNER_REPO%/}"

    if [[ ! "$OWNER_REPO" =~ ^[^/]+/[^/]+$ ]]; then
        echo "ERROR: Invalid GitHub repository URL: ${REPO_URL}" >&2
        exit 1
    fi

    # Parse comma-separated tags, trimming whitespace and skipping empty entries
    SEARCH_TAGS=()
    if [ -n "$TAGS" ]; then
        IFS=',' read -ra RAW_TAGS <<< "$TAGS"
        for tag in "${RAW_TAGS[@]}"; do
            tag="${tag#"${tag%%[![:space:]]*}"}"
            tag="${tag%"${tag##*[![:space:]]}"}"
            if [ -n "$tag" ]; then
                SEARCH_TAGS+=("$tag")
            fi
        done
    fi

    TEMP_JSON_FILE="$(mktemp)"
    trap 'rm -f "$TEMP_JSON_FILE"' EXIT

    API_URL="https://api.github.com/repos/${OWNER_REPO}/releases/latest"
    echo "==> Fetching latest release info for '${OWNER_REPO}'..."
    if [ "${#SEARCH_TAGS[@]}" -gt 0 ]; then
        echo "    Matching assets containing all tags (case-insensitive): ${SEARCH_TAGS[*]}"
    fi

    CURL_ARGS=(
        -sL
        -o "$TEMP_JSON_FILE"
        -w "%{http_code}"
        -H "Accept: application/vnd.github.v3+json"
        -H "User-Agent: build-justfile-get-gh-release"
    )
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        CURL_ARGS+=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
    fi

    HTTP_STATUS="$(curl "${CURL_ARGS[@]}" "$API_URL")"
    if [ "$HTTP_STATUS" -ne 200 ]; then
        echo "ERROR: Failed to fetch release info for '${OWNER_REPO}'. HTTP Status: ${HTTP_STATUS}" >&2
        if [ -s "$TEMP_JSON_FILE" ]; then
            echo "Response from GitHub:" >&2
            jq -r '.message // empty' "$TEMP_JSON_FILE" 2>/dev/null || cat "$TEMP_JSON_FILE" >&2
        fi
        exit 1
    fi

    TAG_NAME="$(jq -r '.tag_name' "$TEMP_JSON_FILE")"
    echo "    Latest release tag: ${TAG_NAME}"

    DOWNLOAD_URLS=()
    while IFS= read -r ASSET_NAME; do
        [ -n "$ASSET_NAME" ] || continue
        MATCH=true
        LOWER_ASSET_NAME="${ASSET_NAME,,}"
        for SEARCH_TAG in "${SEARCH_TAGS[@]}"; do
            LOWER_TAG="${SEARCH_TAG,,}"
            # Literal substring match (NOT regex =~, which breaks on dots like .rpm)
            if [[ "$LOWER_ASSET_NAME" != *"$LOWER_TAG"* ]]; then
                MATCH=false
                break
            fi
        done
        if [ "$MATCH" = true ]; then
            ASSET_URL="$(jq -r --arg name "$ASSET_NAME" '.assets[] | select(.name == $name) | .browser_download_url' "$TEMP_JSON_FILE")"
            if [ -n "$ASSET_URL" ]; then
                DOWNLOAD_URLS+=("$ASSET_URL")
            fi
        fi
    done < <(jq -r '.assets[].name' "$TEMP_JSON_FILE")

    if [ "${#DOWNLOAD_URLS[@]}" -eq 0 ]; then
        echo "ERROR: No assets found matching all tags: ${SEARCH_TAGS[*]:-<none>}" >&2
        echo "Available assets in ${TAG_NAME}:" >&2
        jq -r '.assets[].name' "$TEMP_JSON_FILE" >&2
        exit 1
    fi

    mkdir -p "$OUT_DIR"
    for ASSET_URL in "${DOWNLOAD_URLS[@]}"; do
        FILENAME="$(basename "$ASSET_URL")"
        echo "  -> Downloading ${FILENAME} into ${OUT_DIR}..."
        curl -fsSL -o "${OUT_DIR}/${FILENAME}" "$ASSET_URL"
    done
    echo "==> Downloaded ${#DOWNLOAD_URLS[@]} asset(s) from ${OWNER_REPO}@${TAG_NAME}"

# Clean DNF/DNF5 caches, PackageKit/app-info caches, and package manager logs
[group('helpers')]
cleanup-dnf:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v dnf5 >/dev/null 2>&1; then
        dnf5 clean all || true
    elif command -v dnf >/dev/null 2>&1; then
        dnf clean all || true
    fi
    rm -rf /var/cache/dnf/* \
           /var/cache/PackageKit/* \
           /var/cache/app-info/* \
           /var/log/dnf*.log \
           /var/log/hawkey.log || true

# Refresh /usr/share/factory/etc from /etc and strip runtime-owned files
[group('helpers')]
snapshot-factory-etc:
    #!/usr/bin/env bash
    set -euo pipefail
    # etc-overlay-sync.service restores this snapshot over /etc on every container
    # boot. Runtime-owned files must NOT be baked into the snapshot: copying a
    # stale copy back over /etc re-clobbers the value the runtime just generated.
    # The most damaging case is machine-id — systemd writes it during early boot,
    # and a re-zeroed id kills user@UID.service and every D-Bus session bus that
    # needs a machine id (code 49 / "Invalid machine ID"). hostname and resolv.conf
    # are likewise owned by the container runtime, and the build-time hostname must
    # not leak into every instance. Keep this list in sync with etc-overlay-sync.
    rm -rf /usr/share/factory/etc
    mkdir -p /usr/share/factory/etc
    cp -a /etc/. /usr/share/factory/etc/
    rm -f /usr/share/factory/etc/machine-id \
          /usr/share/factory/etc/machine-info \
          /usr/share/factory/etc/hostname \
          /usr/share/factory/etc/resolv.conf

# Compile and install a custom SELinux policy module from a (potentially read-only) source directory
[group('helpers')]
install-selinux-module src_dir name *relabel_paths:
    #!/usr/bin/env bash
    set -euo pipefail

    SRC_DIR="{{src_dir}}"
    NAME="{{name}}"
    RELABEL_PATHS=({{relabel_paths}})

    TMPDIR="$(mktemp -d)"
    trap 'rm -rf "$TMPDIR"' EXIT

    cp -a "${SRC_DIR}/." "${TMPDIR}/"
    chmod -R u+w "${TMPDIR}"

    if [ -f "${TMPDIR}/Makefile" ]; then
        make -C "${TMPDIR}"
    else
        make -C "${TMPDIR}" -f /usr/share/selinux/devel/Makefile "${NAME}.pp"
    fi

    mkdir -p /usr/share/selinux/packages
    cp "${TMPDIR}/${NAME}.pp" "/usr/share/selinux/packages/${NAME}.pp"
    semodule -i "${TMPDIR}/${NAME}.pp"

    if [ "${#RELABEL_PATHS[@]}" -gt 0 ]; then
        for p in "${RELABEL_PATHS[@]}"; do
            restorecon -RF "$p" || true
        done
    fi

# Rebuild initramfs for the active kernel using dracut
[group('helpers')]
rebuild-initramfs:
    #!/usr/bin/env bash
    set -euo pipefail

    CREATED_ROOTHOME=false
    if [ ! -d /var/roothome ]; then
        mkdir -p /var/roothome
        CREATED_ROOTHOME=true
    fi
    cleanup() {
        if [ "$CREATED_ROOTHOME" = true ]; then
            rm -rf /var/roothome
        fi
    }
    trap cleanup EXIT

    KVER="$(just -f "{{justfile()}}" get-active-kernel)"
    dracut -f --kver "$KVER"

