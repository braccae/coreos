# Install ELRepo kmod-game-controllers and link into weak-updates without rebuilding initramfs
[group('workstation-alma')]
install-elrepo-game-controllers:
    #!/usr/bin/env bash
    # ELRepo ships the in-tree xpad/hid-playstation/hid-nintendo modules that the
    # EL10 kernel package omits. The package is built for an older kernel; the
    # weak-modules call links it into the image kernel's weak-updates directory.
    # Scriptlets are skipped to avoid dracut trying to build an initramfs in the
    # container; game controllers are runtime-only modules.
    set -euo pipefail
    just -f "{{justfile()}}" setup-repos elrepo
    dnf install -y --setopt=tsflags=noscripts kmod-game-controllers
    find /lib/modules/*/extra/game-controllers -name '*.ko' | \
        /usr/sbin/weak-modules --add-modules --no-initramfs

# Configure Alma workstation defaults: graphical target, desktop services, mDNS firewall rule, fingerprint auth
[group('workstation-alma')]
configure-alma-workstation:
    #!/usr/bin/env bash
    # Graphical boot via Plasma Login Manager (Alias=display-manager.service).
    # Services that are D-Bus or udev activated (bolt, fprintd, iio-sensor-proxy,
    # ipp-usb) need no enablement; the units below are the ones that do:
    #   cups.socket/cups-browsed  driverless + discovered printers and scanners
    #   avahi-daemon.socket       mDNS/DNS-SD discovery (also for remote CUPS)
    #   tuned-ppd.service         power-profiles API for Plasma's powerdevil
    #   pcscd.socket              smartcard readers
    # firewalld blocks mDNS on the public zone, which breaks automatic printer and
    # scanner discovery; allow the service permanently. Fingerprint login needs
    # the authselect feature in addition to fprintd-pam.
    set -euo pipefail
    systemctl set-default graphical.target
    systemctl enable \
        plasmalogin.service \
        cups.socket \
        cups-browsed.service \
        avahi-daemon.socket \
        bluetooth.service \
        tuned-ppd.service \
        ModemManager.service \
        pcscd.socket
    firewall-offline-cmd --zone=public --add-service=mdns
    authselect enable-feature with-fingerprint

# --- Webtop (Fedora/Bazzite & AlmaLinux) --------------------------------------

# Fetch plasma-nm SRPM and install its build dependencies (cacheable layer before patching)
[group('webtop')]
prepare-plasma-nm-builddeps version="6.7.5" release="1.fc44":
    #!/usr/bin/env bash
    # plasma-nm draws "network-unavailable" for Tun/Veth devices, which is
    # exactly what a container uplink is (pasta tap / netavark veth). Prepare the
    # SRPM and its builddeps in /tmp/rpmbuild because /root is a dangling symlink
    # to /var/roothome on this base.
    set -euo pipefail

    VERSION="{{version}}"
    RELEASE="{{release}}"

    dnf5 install -y dnf5-plugins rpm-build curl
    mkdir -p /tmp/srpm \
             /tmp/rpmbuild/BUILD \
             /tmp/rpmbuild/RPMS \
             /tmp/rpmbuild/SOURCES \
             /tmp/rpmbuild/SPECS \
             /tmp/rpmbuild/SRPMS
    curl -fsSL -o "/tmp/srpm/plasma-nm-${VERSION}-${RELEASE}.src.rpm" \
        "https://kojipkgs.fedoraproject.org/packages/plasma-nm/${VERSION}/${RELEASE}/src/plasma-nm-${VERSION}-${RELEASE}.src.rpm"
    rpm -i --define "_topdir /tmp/rpmbuild" /tmp/srpm/plasma-nm-*.src.rpm
    dnf5 builddep -y /tmp/rpmbuild/SPECS/plasma-nm.spec

# Apply local tun/veth patch to plasma-nm and build binary RPMs into /tmp/rpmbuild/RPMS
[group('webtop')]
build-plasma-nm patch_dir="/tmp/plasma-nm":
    #!/usr/bin/env bash
    set -euo pipefail

    PATCH_DIR="{{patch_dir}}"
    if [ ! -f /tmp/rpmbuild/SPECS/plasma-nm.spec ]; then
        just -f "{{justfile()}}" prepare-plasma-nm-builddeps
    fi

    sed -i 's/^Release:.*/Release: 1%{?dist}.webtop1/' /tmp/rpmbuild/SPECS/plasma-nm.spec
    cp "${PATCH_DIR}/0001-plasma-nm-treat-tun-veth-as-wired.patch" /tmp/rpmbuild/SOURCES/
    if ! grep -q '^Patch0: 0001-plasma-nm-treat-tun-veth-as-wired.patch' /tmp/rpmbuild/SPECS/plasma-nm.spec; then
        sed -i '/^Release:/a Patch0: 0001-plasma-nm-treat-tun-veth-as-wired.patch' /tmp/rpmbuild/SPECS/plasma-nm.spec
    fi
    rpmbuild -bb --nodeps --define "_topdir /tmp/rpmbuild" /tmp/rpmbuild/SPECS/plasma-nm.spec

# Upgrade only already-installed plasma-nm subpackages from built RPMs
[group('webtop')]
install-plasma-nm rpms_dir="/tmp/plasma-nm-rpms":
    #!/usr/bin/env bash
    # Upgrade only the plasma-nm subpackages the base image already has; the SRPM
    # also emits VPN plugins/debuginfo that should not be pulled in. dnf5's
    # "upgrade <rpm>" ignores local files, so install each existing package by path.
    set -euo pipefail

    RPMS_DIR="{{rpms_dir}}"
    rpms=()
    for rpm_file in "${RPMS_DIR}"/*/plasma-nm-*.rpm; do
        [ -e "$rpm_file" ] || continue
        name="$(rpm -qp --qf '%{NAME}' "$rpm_file")"
        case "$name" in
            *-debuginfo) continue ;;
        esac
        if rpm -q "$name" >/dev/null 2>&1; then
            rpms+=("$rpm_file")
        fi
    done

    if [ "${#rpms[@]}" -eq 0 ]; then
        echo "ERROR: No matching installed plasma-nm RPMs found under ${RPMS_DIR}" >&2
        exit 1
    fi
    rpm -Uvh --replacepkgs --oldpackage "${rpms[@]}"

