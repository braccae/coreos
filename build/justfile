# Install Selkies streaming server into a private /opt/selkies venv (via uv or python3 venv+pip)
[group('webtop')]
install-selkies version="2.1.0" use_uv="false":
    #!/usr/bin/env bash
    # selkies 2.1 brings its own Wayland compositor (pixelflux), audio engine
    # (pcmflux), and bundled web dashboard. Install from PyPI into a private
    # /opt/selkies venv.
    set -euo pipefail

    VERSION="{{version}}"
    export UV_CACHE_DIR=/tmp/uv-cache
    mkdir -p /var/opt

    case "{{use_uv}}" in
        true|1|yes)
            uv venv /opt/selkies --python python3
            uv pip install --python /opt/selkies/bin/python --no-cache "selkies==${VERSION}"
            ;;
        false|0|no)
            # Use /usr/bin/python3 explicitly: rootfs/common/ copies usr/sbin/,
            # which turns Bazzite's /usr/sbin -> bin symlink into a real
            # directory, so a venv built from /usr/sbin/python3 would break.
            /usr/bin/python3 -m venv /opt/selkies
            /opt/selkies/bin/pip install --no-cache-dir "selkies==${VERSION}"
            ;;
        *)
            echo "ERROR: Invalid use_uv value '{{use_uv}}'. Expected 'true' or 'false'." >&2
            exit 1
            ;;
    esac
    rm -rf /tmp/uv-cache

# Configure Fedora/Bazzite webtop: interposer symlink, nginx, container DNS, webtop user, units, compat symlinks
[group('webtop')]
configure-webtop-fedora:
    #!/usr/bin/env bash
    set -euo pipefail

    # Upstream ships the joystick interposer as a copy of the input one.
    ln -sf selkies_input_interposer.so /usr/lib/selkies_joystick_interposer.so

    # Replace nginx default config
    rm -f /etc/nginx/conf.d/default.conf

    # Container DNS: keep podman's /etc/resolv.conf and resolve through it directly.
    # NetworkManager would replace it with container DHCP DNS (169.254.1.1) and
    # Fedora's nsswitch stops at "resolve [!UNAVAIL=return]" before reaching "dns".
    mkdir -p /etc/NetworkManager/conf.d
    printf '[main]\ndns=none\n' > /etc/NetworkManager/conf.d/99-webtop-dns.conf
    sed -i 's/^hosts:.*/hosts:      files dns/' /etc/nsswitch.conf
    if [ -d /usr/share/factory/etc ]; then
        cp -a /etc/nsswitch.conf /usr/share/factory/etc/nsswitch.conf
    fi
    systemctl disable systemd-resolved.service 2>/dev/null || true

    # Webtop user setup
    if ! id webtop >/dev/null 2>&1; then
        useradd -m -u 1000 -G wheel webtop
    fi
    usermod -U webtop
    passwd -d webtop
    echo "webtop ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/webtop

    # Disable display managers & hardware-specific units inside the container
    systemctl disable plasmalogin.service sddm.service 2>/dev/null || true
    systemctl disable cardwired.service 2>/dev/null || true

    chmod +x /usr/local/bin/start-webtop.sh \
             /usr/local/bin/webtop-gpu-report \
             /usr/local/bin/webtop-appimage-run \
             /usr/local/bin/webtop-nm-uplink \
             /usr/local/bin/webtop-entrypoint \
             /usr/local/bin/webtop-wait-tailscale

    # Strip kwin_wayland file caps that cause EPERM in rootless containers
    setcap -r /usr/bin/kwin_wayland || true

    # Compat symlinks: Steam calls /sbin/ldconfig, tailscaled unit calls
    # /usr/sbin/tailscaled, and WARP firewall calls /usr/sbin/nft, while Fedora
    # installs all three under /usr/bin.
    [ -e /usr/sbin/ldconfig ] || ln -s ../bin/ldconfig /usr/sbin/ldconfig
    ln -sf ../bin/tailscaled /usr/sbin/tailscaled
    ln -sf ../bin/nft /usr/sbin/nft

    systemctl enable \
        webtop.service \
        webtop-nm-uplink.service \
        webtop-flatpak-appstream.service
    systemctl enable etc-overlay-sync.service 2>/dev/null || true

# Install KDE Plasma 6 desktop, Wayland/Xwayland, Mesa, and PipeWire packages for Alma webtop
[group('webtop')]
install-webtop-alma-deps:
    # plasma-workspace/plasma-desktop/kwin are 6.6.x in EPEL 10. Xwayland and mesa
    # are needed for X11 client apps; pipewire + wireplumber are the audio stack.
    # dbus-daemon provides /usr/bin/dbus-run-session on EL 10.
    dnf install -y \
        plasma-workspace \
        plasma-desktop \
        kwin \
        kdecoration \
        plasma-breeze \
        breeze-icon-theme \
        polkit-kde \
        konsole \
        qt6-qtwayland \
        xorg-x11-server-Xwayland \
        libxcvt \
        mesa-dri-drivers \
        mesa-libEGL \
        dejavu-sans-fonts \
        pipewire \
        wireplumber \
        pipewire-pulseaudio \
        pulseaudio-utils \
        alsa-utils \
        dbus-daemon

# Configure Alma webtop: core user, factory /etc sync, KDE defaults, XDG dirs, webtop.service, kwin caps
[group('webtop')]
configure-webtop-alma:
    #!/usr/bin/env bash
    set -euo pipefail

    # Create `core` user (base image ships no user; `core` is normally provisioned
    # by bootc-image-builder). Materialize video/render lines in /etc/group first
    # because systemd-sysusers groups resolve via NSS but useradd/usermod validate
    # against /etc/group directly. Refresh factory /etc account files so
    # etc-overlay-sync.service does not discard `core` in container mode.
    if ! getent group core >/dev/null 2>&1; then
        groupadd -g 1000 core
    fi
    if ! id core >/dev/null 2>&1; then
        useradd -m -u 1000 -g 1000 -G wheel -s /bin/bash core
    fi
    grep -q '^video:'  /etc/group || echo 'video:x:39:'   >> /etc/group
    grep -q '^render:' /etc/group || echo 'render:x:105:' >> /etc/group
    usermod -aG video,render core
    echo 'core:webtop' | chpasswd
    echo "core ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/core
    mkdir -p /usr/share/factory/etc/sudoers.d
    cp -a /etc/passwd /etc/group /etc/shadow /etc/gshadow /usr/share/factory/etc/
    cp -a /etc/sudoers.d/core /usr/share/factory/etc/sudoers.d/core
    rm -f /usr/share/factory/etc/machine-id

    # Seed streaming-friendly KDE defaults: disable screen locking, pick Breeze
    # look-and-feel, and hide wl-clipboard helper windows from taskbar/switcher.
    # Compositing is deliberately NOT disabled (KWin on Wayland stops producing
    # frames when kwinrc turns it off).
    mkdir -p /home/core/.config
    printf '[Daemon]\nAutolock=false\n' > /home/core/.config/kscreenlockerrc
    printf '[KDE]\nLookAndFeelPackage=org.kde.breeze.desktop\n' > /home/core/.config/kdeglobals
    cat > /home/core/.config/kwinrulesrc << 'EOF'
    [General]
    count=1
    rules=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

    [aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee]
    Description=wl-clipboard support
    wmclass=wl-(copy|paste)
    wmclassmatch=3
    skiptaskbar=true
    skiptaskbarrule=2
    skipswitcher=true
    skipswitcherrule=2
    fsplevel=3
    fsplevelrule=2
    noborder=true
    noborderrule=2
    EOF
    chown -R core:core /home/core/.config

    # Selkies' dashboard uploads into $HOME/Desktop; create XDG dirs up front.
    mkdir -p /home/core/Desktop /home/core/Downloads /etc/webtop-alma
    chown -R core:core /home/core
    chmod +x /usr/local/bin/start-webtop.sh /usr/local/bin/socket-activate-shim
    systemctl enable webtop.service

    # EPEL's kwin_wayland ships cap_sys_nice=ep. Rootless containers drop that
    # capability, causing execve to fail with EPERM even for root.
    setcap -r /usr/bin/kwin_wayland /usr/bin/kwin_wayland_wrapper 2>/dev/null || true
