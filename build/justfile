# Install Docker CE engine (replacing podman-docker shim) and enable docker.service
[group('alma-variants')]
install-docker:
    #!/usr/bin/env bash
    set -euo pipefail
    just -f "{{justfile()}}" setup-repos docker
    # --allowerasing: the Alma base ships podman-docker, whose `docker` command
    # conflicts with docker-ce. Let the transaction replace the shim with the real
    # engine instead of failing the build.
    dnf install -y --allowerasing \
        docker-ce \
        docker-ce-cli \
        containerd.io \
        docker-buildx-plugin \
        docker-compose-plugin
    systemctl enable docker

# Build the chabad360/cockpit-docker RPM from source and copy resulting RPMs to out_dir
[group('alma-variants')]
build-cockpit-docker out_dir="/tmp/cockpit-docker-rpms":
    #!/usr/bin/env bash
    set -euo pipefail

    OUT_DIR="{{out_dir}}"
    dnf install -y \
        git \
        gettext \
        nodejs \
        make \
        libappstream-glib \
        libappstream-glib-devel \
        rpm-build

    # On Alma bootc, /root is a dangling symlink to /var/roothome, which breaks
    # rpmbuild's default ~/rpmbuild directory creation.
    rm -rf /root

    TMPDIR="$(mktemp -d)"
    trap 'rm -rf "$TMPDIR"' EXIT

    git clone https://github.com/chabad360/cockpit-docker.git "${TMPDIR}/cockpit-docker"
    (
        cd "${TMPDIR}/cockpit-docker"
        NODE_ENV=production make rpm
    )

    mkdir -p "$OUT_DIR"
    cp "${TMPDIR}/cockpit-docker"/*.rpm "${OUT_DIR}/"

# Install built cockpit-docker RPMs from rpms_dir
[group('alma-variants')]
install-cockpit-docker rpms_dir="/tmp/cockpit-docker-rpms":
    rpm -i --nodeps "{{rpms_dir}}"/*.rpm

# Install Nix from EPEL and seed persistent /var/lib/nix from /nix
[group('alma-variants')]
install-nix:
    #!/usr/bin/env bash
    set -euo pipefail
    # Nix ships only in the dx image (EPEL repository is inherited from base).
    PKGS=(nix)
    rpm -q checkpolicy >/dev/null 2>&1 || PKGS+=(checkpolicy)
    rpm -q make >/dev/null 2>&1 || PKGS+=(make)
    dnf install -y "${PKGS[@]}"

    # /nix sits on the read-only composefs deployment root, so the store would be
    # lost on every image update. Seed the persistent backing directory
    # /var/lib/nix from the freshly installed /nix; `just setup-nix` merges the
    # deployment's store into it and then bind-mounts it over /nix.
    mkdir -p /var/lib/nix
    cp -a /nix/. /var/lib/nix/

