# Install Cockpit components for a profile (base | zfs | hci | docker)
[group('alma-base')]
install-cockpit profile="base":
    #!/usr/bin/env bash
    set -euo pipefail

    PROFILE="{{profile}}"
    case "$PROFILE" in
        base)
            # cockpit-ws runs as a quadlet container (rootfs/hci/etc/containers/systemd/cockpit-ws.container.builtin),
            # so the host ships cockpit-bridge and plugins rather than cockpit-ws.
            dnf install -y \
                cockpit-system \
                cockpit-bridge \
                cockpit-networkmanager \
                cockpit-podman \
                cockpit-ostree \
                cockpit-selinux \
                cockpit-storaged \
                cockpit-files
            ;;
        zfs)
            TMPDIR="$(mktemp -d)"
            trap 'rm -rf "$TMPDIR"' EXIT
            git clone https://github.com/45drives/cockpit-zfs-manager.git "${TMPDIR}/cockpit-zfs-manager"
            cp -r "${TMPDIR}/cockpit-zfs-manager/zfs" /usr/share/cockpit
            curl -fsSL https://raw.githubusercontent.com/45drives/scripts/refs/heads/main/cockpit_font_fix/fix-cockpit.sh | bash
            ;;
        hci)
            dnf install -y cockpit-machines
            TMPDIR="$(mktemp -d)"
            CREATED_ROOTHOME=false
            if [ ! -d /var/roothome ]; then
                mkdir -p /var/roothome
                CREATED_ROOTHOME=true
            fi
            cleanup() {
                rm -rf "$TMPDIR"
                if [ "$CREATED_ROOTHOME" = true ]; then
                    rm -rf /var/roothome
                fi
            }
            trap cleanup EXIT

            just -f "{{justfile()}}" get-gh-release https://github.com/45Drives/cockpit-identities "el9,noarch,.rpm" "$TMPDIR"
            just -f "{{justfile()}}" get-gh-release https://github.com/45Drives/cockpit-file-sharing "el9,noarch,.rpm" "$TMPDIR"
            dnf install -y "${TMPDIR}"/*.rpm
            ;;
        docker)
            just -f "{{justfile()}}" install-cockpit-docker
            ;;
        *)
            echo "ERROR: Unknown cockpit profile '${PROFILE}'. Expected one of: base, zfs, hci, docker" >&2
            exit 1
            ;;
    esac

