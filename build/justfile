# Install the Hermes Agent CLI system-wide under /usr/local/lib/hermes-agent
[group('alma-base')]
install-hermes:
    #!/usr/bin/env bash
    # Install the Hermes Agent CLI system-wide into the base image.
    #
    # Why this shape (all verified empirically against the real base image, see
    # commit 800f622):
    #   * The upstream installer (https://hermes-agent.nousresearch.com/install.sh)
    #     is interactive and per-user by default. We run it non-interactively as
    #     root so the CLI lands in the *image*, not in a user's home.
    #   * HERMES_INSTALL_DIR = where the git checkout + launchers live.
    #   * HERMES_HOME        = where config, state and the committed dependency
    #     environment live. Keeping it *equal to the install dir* means the sealed
    #     dependency facts (/usr/local/lib/hermes-agent/installs/<key>/facts.json)
    #     resolve for a bare `podman run ... hermes`, not just for a login shell.
    #     The Containerfile bakes the same value as `ENV HERMES_HOME` so runtime
    #     exec inherits it (this mirrors the upstream image's `ENV HERMES_HOME`).
    #   * --skip-browser --skip-computer-use: this is a server/OS image, not a
    #     browser host. The CLI, gateway and agent runtime remain fully functional.
    #
    # The published launcher hardcodes absolute paths under the install dir, so the
    # system-wide publish is a *symlink*, not a copy.
    set -euo pipefail

    export HERMES_INSTALL_DIR=/usr/local/lib/hermes-agent
    export HERMES_HOME=/usr/local/lib/hermes-agent

    # In the Alma bootc base /root is a symlink to /var/roothome, which does not
    # exist yet. The installer needs a writable HOME to stage its downloads, so
    # create the real directory and point HOME at it for the duration of the build.
    CREATED_ROOTHOME=false
    if [ ! -d /var/roothome ]; then
        mkdir -p /var/roothome
        CREATED_ROOTHOME=true
    fi
    cleanup() {
        if [ "$CREATED_ROOTHOME" = true ]; then
            rm -rf /var/roothome
        fi
    }
    trap cleanup EXIT
    export HOME=/var/roothome

    echo "==> Installing Hermes Agent CLI into ${HERMES_INSTALL_DIR}"
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh \
        | bash -s -- --non-interactive --skip-browser --skip-computer-use

    # Publish the CLI on the default PATH for every user without shell rc edits.
    ln -sf "${HERMES_INSTALL_DIR}/.hermes/bin/hermes" /usr/local/bin/hermes

    # The install tree is read/execute-only for non-root users. (Runtime state under
    # HERMES_HOME is owned by root, matching the upstream "one owner" model; a
    # non-root user needs its own install or write access to HERMES_HOME.)
    chmod -R a+rX "${HERMES_INSTALL_DIR}"

    # Best-effort SELinux relabel of the new tree. The targeted policy does not know
    # these paths yet, so never fail the build on it.
    restorecon -R "${HERMES_INSTALL_DIR}" /usr/local/bin/hermes 2>/dev/null || true

    # Drop the staging HOME before verifying the CLI so we prove it does not rely on it.
    if [ "$CREATED_ROOTHOME" = true ]; then
        rm -rf /var/roothome
        CREATED_ROOTHOME=false
    fi

    # Prove the install works at build time (fails the build if the CLI is broken).
    /usr/local/bin/hermes --version

    echo "==> Hermes Agent CLI installed and published at /usr/local/bin/hermes"

# Install Cloudflare WARP client (skipping weak GUI deps) and configure warp-svc enablement
[group('alma-base')]
install-cloudflare-warp enable="false":
    #!/usr/bin/env bash
    # Cloudflare ships a single RPM bundling warp-cli, warp-svc and a desktop GUI.
    # The GUI's hard Requires pull WebKitGTK/GStreamer, so weak dependencies are
    # skipped to trim ~245 MB; warp-cli/warp-svc never use them.
    # Bazzite/ublue images ship /opt as a symlink to var/opt, and /var/opt does
    # not exist, so rpm cannot create /opt/cloudflare-warp (cpio: mkdir failed).
    # The RPM %post enables warp-svc.service; toggle it according to `enable`.
    set -euo pipefail

    mkdir -p /var/opt
    if ! rpm -q cloudflare-warp >/dev/null 2>&1; then
        dnf install -y --setopt=install_weak_deps=False cloudflare-warp
    fi

    case "{{enable}}" in
        true|1|yes)
            systemctl enable warp-svc
            ;;
        false|0|no)
            systemctl disable warp-svc
            ;;
        *)
            echo "ERROR: Invalid enable value '{{enable}}'. Expected 'true' or 'false'." >&2
            exit 1
            ;;
    esac

# Install prebuilt ZFS kmod RPMs if they match the active kernel, run depmod, and rebuild initramfs
[group('alma-base')]
install-zfs-kmods rpms_dir="/tmp/rpms" label="image":
    #!/usr/bin/env bash
    set -euo pipefail

    RPMS_DIR="{{rpms_dir}}"
    LABEL="{{label}}"

    if [ ! -f "${RPMS_DIR}/kernel-version.txt" ]; then
        echo "WARNING: No ZFS kernel modules found in ${RPMS_DIR} for ${LABEL}. Skipping ZFS installation."
        exit 0
    fi

    KMOD_KERNEL="$(cat "${RPMS_DIR}/kernel-version.txt")"
    echo "kmods built for kernel: ${KMOD_KERNEL}"
    CURRENT_KERNEL="$(just -f "{{justfile()}}" get-active-kernel)"
    echo "Current base kernel: ${CURRENT_KERNEL}"

    if [ "$CURRENT_KERNEL" != "$KMOD_KERNEL" ]; then
        echo "WARNING: Kernel version mismatch for ${LABEL}! (Current: ${CURRENT_KERNEL}, Kmods: ${KMOD_KERNEL}). Skipping ZFS installation."
        exit 0
    fi

    if rpm -q zfs-fuse >/dev/null 2>&1; then
        dnf remove -y zfs-fuse
    fi
    dnf install -y "${RPMS_DIR}"/*.rpm

    echo "Correcting ZFS kernel module dependencies..."
    if [ -f "/usr/lib/modules/${CURRENT_KERNEL}/System.map" ]; then
        depmod -a --filesyms "/usr/lib/modules/${CURRENT_KERNEL}/System.map" "${CURRENT_KERNEL}"
    else
        depmod -a "${CURRENT_KERNEL}"
    fi
    echo "✓ ZFS modules installed and depmod completed successfully for kernel ${CURRENT_KERNEL}"

    just -f "{{justfile()}}" rebuild-initramfs

